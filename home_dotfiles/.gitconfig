[core]
    pager = delta
    editor = vim
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
    side-by-side = false
    wrap-max-lines = unlimited
    line-numbers = true
[merge]
    conflictstyle = zdiff3
    tool = vimdiff
[diff]
    colorMoved = default
[user]
    email = 70924991+Mclilzee@users.noreply.github.com
    name = Emad Ali
[init]
    defaultBranch = main
